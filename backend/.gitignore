# Git ignore "básico" para projetos django

# =====================================
# PYTHON / DJANGO
# =====================================

# Byte-compiled
__pycache__/
*.py[cod]
*.pyo

# Virtual env
venv/
env/

# Django stuff
*.log
*.pot
*.pyc
*.sqlite3
db.sqlite3

# Migrations (opcional manter, mas melhor ignorar até projeto estável)
**/migrations/*
!**/migrations/__init__.py

# Environment variables
.env
*.env

# VS Code
.vscode/
*.code-workspace

# =====================================
# NODE / REACT / FRONTEND
# =====================================

# Dependencies
node_modules/

# Build
/build
/dist

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.next/
.nuxt/
out/

# =====================================
# SYSTEM
# =====================================

.DS_Store
Thumbs.db

